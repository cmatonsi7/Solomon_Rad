# Public site URL (no trailing slash). Used for canonical URLs, Open Graph and sitemap.
VITE_SITE_URL=https://www.example.com
# HTTPS endpoint that accepts the enquiry as JSON (your backend, Formspree, Basin, etc.).
# Leave empty and the form will honestly report that it is not connected.
VITE_FORM_ENDPOINT=
# Set to "false" to hide the amber content-placeholder blocks before launch.
VITE_SHOW_PLACEHOLDERS=true
